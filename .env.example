# VibeValuer — example environment
#
# Copy to `.env` and fill in real values. Generate automatically with:
#   node scripts/init-secrets.cjs
#
# Anything you put here is loaded by config.js / src/auth.js / src/session.js.
# Do NOT commit your `.env` — it's in .gitignore.

# ── Server ──────────────────────────────────────────────────────────────
PORT=4310
NODE_ENV=development
VALUER_HARDENED=0                        # set to 1 in production
VALUER_COOKIE_SECURE=0                  # set to 1 when serving over HTTPS

# ── HMAC secrets (256-bit random, base64url-encoded) ─────────────────────
# Generate fresh keys with:  node scripts/init-secrets.cjs
VALUER_AGENT_SECRET=vv_replace_me_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VALUER_ADMIN_SECRET=vv_replace_me_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VALUER_SESSION_SECRET=vv_replace_me_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Session TTL (default 12h)
VALUER_SESSION_TTL_MS=43200000

# ── Vibe indexer (HyperEVM testnet 46630) ────────────────────────────────
VIBE_RPC_URL=https://rpc.testnet.chain.robinhood.com
VIBE_CHAIN_ID=46630
# AUTO_SYNC_WORKER=1                       # uncomment to start polling on boot

# ── Dev users (only used when VALUER_HARDENED=0) ────────────────────────
# For hardened mode, use scrypt hashes here. Generated by init-secrets.cjs.
# Format: { "<username>": { "role": "owner|admin|agent|viewer", "hash": "scrypt-hash" } }
VALUER_USERS_JSON={"owner":{"role":"owner","hash":"$salt$hash"}}

# ── Cron jobs ───────────────────────────────────────────────────────────
# Used by scripts/cron-decay.cjs (nightly reputation decay)
VALUER_BASE_URL=http://127.0.0.1:4310
VALUER_DECAY_USERNAME=owner
VALUER_DECAY_PASSWORD=replace-me
