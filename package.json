    "archive:runs": "node scripts/archive-old-runs.mjs",
    "docs": "node scripts/regen-docs.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
