{
  "name": "VibeValuer",
  "version": "0.1.0",
  "private": true,
  "description": "Agent work evaluation dashboard — VibeValuer",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && node --check public/app.js && node --check src/scoring.js && node --check src/validate.js && node --check src/db.js && node --check src/vibe-adapter.js && node --check src/auth.js && node --check src/session.js",
    "qa:smoke": "node scripts/smoke.cjs",
    "init": "node scripts/init-secrets.cjs",
    "backup": "node scripts/backup.mjs",
    "create-agent": "node scripts/create-agent.mjs",
    "cron:decay": "node scripts/cron-decay.cjs",
